# MASTER AI — Environment Configuration Template
# Copy this file to .env and configure for your environment

# Server Binding & Deployment
PROJECT_NAME="MASTER AI Backend"
VERSION="2.0.0"
ENVIRONMENT="production"
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="https://your-frontend-domain.com"
CORS_ORIGINS="https://your-frontend-domain.com,http://localhost:5173"

# Database (Default: SQLite local database; for PostgreSQL: postgresql://user:pass@localhost:5432/master_ai)
DATABASE_URL="sqlite:///./data/master_ai.db"

# LLM Provider Configuration (Optional: Groq / OpenAI / Anthropic / Ollama)
LLM_PROVIDER=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""

# Fact Checking & Verification Provider
FACT_CHECK_PROVIDER="mock"
MAX_CLAIMS_PER_ANSWER=3
DEBATE_MAX_ROUNDS=6

# Speech-to-Text (faster-whisper)
WHISPER_MODEL="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# RAG & ChromaDB Vector Store
CHROMA_COLLECTION="master_ai_knowledge"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# Security & Upload Limits
MAX_UPLOAD_MB=10
MAX_AUDIO_SIZE_BYTES=26214400

# Demo Mode
DEMO_MODE_ENABLED="true"
